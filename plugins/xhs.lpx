#!name = 小红书
#!desc = 移除小红书开屏广告、信息流广告和图片视频水印
#!author = fmz200, onenora
#!homepage = https://ikuns.netlify.app
#!icon = https://ikuns.netlify.app/img/dt/xhs.webp
#!system = iOS,iPadOS,tvOS,macOS
#!system_version = 15
#!loon_version = 3.5.1(983)
#!tag = 去广告
#!date = 2026-09-27 00:00:00

[Argument]
xhs_enable = switch,true,tag=小红书-脚本开关

[Rule]
DOMAIN, ads-img-qc.xhscdn.com, REJECT
DOMAIN, ads-video-al.xhscdn.com, REJECT
DOMAIN, ads-video-qc.xhscdn.com, REJECT
DOMAIN, t-ads.xiaohongshu.com, REJECT
AND, ((PROTOCOL, QUIC), (DOMAIN-SUFFIX, xiaohongshu.com)), REJECT

[Rewrite]
# 惊喜弹窗
request if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action)/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\?/ then reject_dict(200)
# 信息流
request if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/guide\?/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/detailfeed\/preload\?/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/user_banner/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/(v\d+\/ads\/resource|v\d+\/hey\/\w+\/hey_gallery)/ then reject_dict(200)
# 评论区图片水印
request if ${url} ~= /^https?:\/\/ci\.xiaohongshu\.com\/system_config\/watermark/ then reject_img(200)

[Script]
# 搜索页
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/(banner|hot)_list/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-搜索页", requires_body=true, timeout=60, enable=${xhs_enable}
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/(hint|trending)\?/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-搜索建议", requires_body=true, timeout=60, enable=${xhs_enable}
response if ${url} ~= /^https?:\/\/(so|edith)\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\?/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-搜索结果", requires_body=true, timeout=60, enable=${xhs_enable}
# 开屏广告
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/config\?/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-配置", requires_body=true, timeout=60, enable=${xhs_enable}
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-开屏", requires_body=true, timeout=60, enable=${xhs_enable}
# 详情页,小部件
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-组件", requires_body=true, timeout=60, enable=${xhs_enable}
# 图片水印,视频水印
response if ${url} ~= /^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/(imagefeed|live_photo\/save)/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-图文无水印", requires_body=true, timeout=60, enable=${xhs_enable}
response if ${url} ~= /^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/(followfeed|homefeed)\?/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-信息流", requires_body=true, timeout=60, enable=${xhs_enable}
response if ${url} ~= /^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(v2\/note\/feed|v3\/note\/videofeed)\?/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-视频流", requires_body=true, timeout=60, enable=${xhs_enable}
response if ${url} ~= /^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(v4\/note\/videofeed|v10\/note\/video\/save)\?/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-视频保存", requires_body=true, timeout=60, enable=${xhs_enable}
# 评论区图片、live图水印，表情包下载
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(v5\/note\/comment\/list|v3\/note\/comment\/sub_comments)\?/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-评论区存储", requires_body=true, timeout=60, enable=${xhs_enable}
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/interaction\/comment\/video\/download\?/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/xhs.js") with tag="小红书-评论区下载", requires_body=true, timeout=60, enable=${xhs_enable}

[Mitm]
hostname = edith.xiaohongshu.com, www.xiaohongshu.com, ci.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com
