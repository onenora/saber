[Script]
# 美图秀秀
response if ${url} ~= /^https?:\/\/((h5|api)\.xiuxiu|api-sub|api\.posters)\.meitu\.com\/.+\/(vip|user|h\d|center|home)/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/mt.js") with tag="美图秀秀", requires_body=true, timeout=60

# 美图子应用 (Wink 等)
response if ${url} ~= /^https:\/\/api-.*\.meitu\.com\/(.+\/user\/vip_info|user\/show)/ then script("https://raw.githubusercontent.com/onenora/saber/main/scripts/mt.js") with tag="美图子应用", requires_body=true, timeout=60

[Mitm]
hostname = *.xiuxiu.meitu.com, api.posters.meitu.com, api-*.meitu.com
